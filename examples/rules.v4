# Example filter rules (iptables-save style) for offline checking:
#   python -m iptable_lite --rules examples/rules.v4 --check examples/packets.hex
*filter
# Default policy: anything that matches no rule is DROPPED.
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
# Stateless shortcut: replies to connections we opened (or related traffic) pass.
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# Allow inbound SSH from anywhere.
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
# Allow inbound web only from the LAN.
-A INPUT -s 192.168.1.0/24 -p tcp -m tcp --dport 80 -j ACCEPT
# Drop ICMP coming from anywhere except 10.0.0.7 (negated source).
-A INPUT ! -s 10.0.0.7 -p icmp -j DROP
# Never forward traffic crossing subnets toward .5.5.
-A FORWARD -s 172.16.0.0/16 ! -d 172.16.5.5 -j DROP
COMMIT
