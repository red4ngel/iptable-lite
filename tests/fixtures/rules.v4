# Generated by hand to look like `iptables-save -t filter`
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -s 192.168.1.0/24 -p tcp -m tcp --dport 80 -j ACCEPT
-A INPUT ! -s 10.0.0.7 -p icmp -j DROP
-A FORWARD -s 172.16.0.0/16 ! -d 172.16.5.5 -j DROP
COMMIT
